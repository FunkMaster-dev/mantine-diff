{
  "name": "@funkmaster/mantine-diff",
  "version": "0.0.0",
  "description": "Diff component for mantine",
  "homepage": "https://github.com/FunkMaster-dev/mantine-diff#readme",
  "packageManager": "yarn@4.18.1",
  "license": "MIT",
  "author": "Boaz Geller",
  "keywords": [
    "extension",
    "mantine"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css"
  },
  "repository": "https://github.com/FunkMaster-dev/mantine-diff.git",
  "dependencies": {
    "clsx": "^2.1.1",
    "es-toolkit": "^1.53.1"
  },
  "peerDependencies": {
    "@mantine/core": ">=9.0.0",
    "@mantine/hooks": ">=9.0.0",
    "@tabler/icons-react": ">=3.0.0",
    "react": "^18.x || ^19.x",
    "react-dom": "^18.x || ^19.x"
  },
  "bugs": "https://github.com/FunkMaster-dev/mantine-diff/issues"
}
